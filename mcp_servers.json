{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "${WORKSPACE}"]
    },
    "git": {
      "command": "uvx",
      "args": ["mcp-server-git"],
      "cwd": "${WORKSPACE}"
    },
    "satellite": {
      "command": "${SAT_TRACK_MCP_ROOT}/.venv/Scripts/python.exe",
      "args": ["-m", "sat_track_mcp.server"],
      "cwd": "${SAT_TRACK_MCP_ROOT}"
    },
    "hotel": {
      "command": "${HOTEL_MCP_ROOT}/.venv/Scripts/python.exe",
      "args": ["-m", "hotel_mcp"],
      "cwd": "${HOTEL_MCP_ROOT}",
      "env": {
        "HOTEL_DB": "${HOTEL_MCP_ROOT}/data/hotel_chatbot.db",
        "HOTEL_EXPORT_DIR": "${HOTEL_MCP_ROOT}/comprobantes"
      }
    },
    "peliculas": {
      "command": "${PELICULAS_MCP_ROOT}/.venv/Scripts/python.exe",
      "args": ["server.py"],
      "cwd": "${PELICULAS_MCP_ROOT}"
    },
    "satellite-remote": {
      "url": "https://satellite-remote-mcp.erickguerra2.workers.dev/mcp"
    },
    "mixassist": {
      "command": "${MIXASSIST_MCP_ROOT}/.venv/Scripts/python.exe",
      "args": ["-m", "mixassist_mcp.server"],
      "cwd": "${MIXASSIST_MCP_ROOT}"
    }
  }
}
