mpc-server-peliculas/
mixassist-mcp-server/

# Local test audio for mixassist-mcp-server (large, not ours to redistribute)
/*.wav

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/

# Secrets / local config
.env

# MCP interaction logs (generated at runtime)
logs/

# Sandbox directory the Filesystem/Git MCP servers are allowed to touch
workspace/

# Files attached from the web GUI (chatbot/web.py's /upload endpoint)
uploads/
